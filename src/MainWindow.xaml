<Window x:Class="LersMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LersMonitor"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="ЛЭРС УЧЁТ — Экспресс Мониторинг"
        Height="860" Width="1400"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SystemBackground}"
        Foreground="{DynamicResource LabelPrimary}"
        FontFamily="SF Pro Display, -apple-system, Segoe UI Variable Display, Segoe UI, Helvetica"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ═══ Bento / BoardUI Color Palette (Defaults to Dark, updated dynamically by ApplyThemeColors) ═══ -->
        <SolidColorBrush x:Key="SystemBackground" Color="#09090B"/>
        <SolidColorBrush x:Key="CardBackground" Color="#121215"/>
        <SolidColorBrush x:Key="CardBackgroundAlt" Color="#18181C"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#26262C"/>
        <SolidColorBrush x:Key="BorderBrushSubtle" Color="#1E1E24"/>
        <SolidColorBrush x:Key="LabelPrimary" Color="#F4F4F5"/>
        <SolidColorBrush x:Key="LabelSecondary" Color="#A1A1AA"/>
        <SolidColorBrush x:Key="LabelTertiary" Color="#52525B"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#0A84FF"/>
        <SolidColorBrush x:Key="AccentBlueHover" Color="#3B9CFF"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#30D158"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FF453A"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#FF9F0A"/>
        <SolidColorBrush x:Key="AccentGray" Color="#71717A"/>
        <SolidColorBrush x:Key="AccentTeal" Color="#38BDF8"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#BF5AF2"/>
        <SolidColorBrush x:Key="AccentPink" Color="#FF375F"/>
        <SolidColorBrush x:Key="AccentIndigo" Color="#5E5CE6"/>
        <SolidColorBrush x:Key="InputBackground" Color="#18181C"/>
        <SolidColorBrush x:Key="HeaderBackground" Color="#121215"/>
        <SolidColorBrush x:Key="SelectionBackground" Color="#0A84FF"/>
        <SolidColorBrush x:Key="SelectionForeground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SegmentedBg" Color="#16161A"/>
        <SolidColorBrush x:Key="SegmentedSelectedBg" Color="#27272E"/>
        <SolidColorBrush x:Key="StatusDotOk" Color="#30D158"/>
        <SolidColorBrush x:Key="StatusDotErr" Color="#FF453A"/>
        <SolidColorBrush x:Key="StatusDotWait" Color="#FF9F0A"/>

        <!-- Bento Status Surface Tints & Hairline Borders -->
        <SolidColorBrush x:Key="StatusOkBg" Color="#122319"/>
        <SolidColorBrush x:Key="StatusOkBorder" Color="#1F4A30"/>
        <SolidColorBrush x:Key="StatusErrBg" Color="#291416"/>
        <SolidColorBrush x:Key="StatusErrBorder" Color="#592226"/>
        <SolidColorBrush x:Key="StatusWarnBg" Color="#291E11"/>
        <SolidColorBrush x:Key="StatusWarnBorder" Color="#573D1A"/>
        <SolidColorBrush x:Key="StatusIdleBg" Color="#19191E"/>
        <SolidColorBrush x:Key="StatusIdleBorder" Color="#2A2A32"/>
        <SolidColorBrush x:Key="StatusInfoBg" Color="#112233"/>
        <SolidColorBrush x:Key="StatusInfoBorder" Color="#1E3F60"/>
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#32323A"/>
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#484854"/>

        <!-- ═══ Subtle Bento Shadows ═══ -->
        <DropShadowEffect x:Key="CardShadow" Color="#000000" BlurRadius="20" ShadowDepth="2" Opacity="0.18" Direction="270"/>
        <DropShadowEffect x:Key="PopupShadow" Color="#000000" BlurRadius="32" ShadowDepth="8" Opacity="0.35" Direction="270"/>

        <!-- ═══ Bento Card Container Style ═══ -->
        <Style x:Key="BentoCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
        </Style>

        <!-- ═══ Minimalist ScrollBar ═══ -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="1">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="thumbBd" Background="{DynamicResource ScrollThumbBrush}" CornerRadius="3" Margin="1"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="thumbBd" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="MinHeight" Value="8"/>
                    <Setter Property="Width" Value="Auto"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══ TextBox — Bento Style ═══ -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource LabelTertiary}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Компактное числовое поле ═══ -->
        <Style x:Key="CompactNumericTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="76"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <!-- ═══ ComboBox — Bento Style ═══ -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="templateRoot"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"/>
                            <ToggleButton x:Name="toggleButton"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" CornerRadius="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="26"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="arrow" Grid.Column="1" Data="M0,0 L4,4 L8,0"
                                                      Stroke="{DynamicResource LabelSecondary}" StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="contentPresenter"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,0,26,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade" Placement="Bottom">
                                <Border x:Name="shadowBorder" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="12" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}" Margin="0,4,0,0" Padding="4" Effect="{StaticResource PopupShadow}">
                                    <ScrollViewer x:Name="DropDownScrollViewer" Margin="0" SnapsToDevicePixels="True">
                                        <ItemsPresenter x:Name="ItemsPresenter" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="templateRoot" Property="BorderBrush" Value="{DynamicResource LabelTertiary}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="templateRoot" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Margin="2,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardBackgroundAlt}"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectionBackground}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SelectionForeground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ DatePicker — Bento Style ═══ -->
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="4,0">
                            <Grid x:Name="PART_Root">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   VerticalAlignment="Center"/>
                                <Button x:Name="PART_Button" Grid.Column="1" Width="26" Height="26"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent" CornerRadius="6">
                                                <TextBlock Text="📅" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding ElementName=bd}" StaysOpen="False"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource LabelTertiary}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ PasswordBox — Bento Style ═══ -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource LabelTertiary}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Primary & Secondary Buttons — Bento Pills ═══ -->
        <Style x:Key="ApplePrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BentoSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource LabelTertiary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppleGreenButton" TargetType="Button" BasedOn="{StaticResource ApplePrimaryButton}">
            <Setter Property="Background" Value="{DynamicResource AccentGreen}"/>
        </Style>

        <Style x:Key="AppleRedButton" TargetType="Button" BasedOn="{StaticResource ApplePrimaryButton}">
            <Setter Property="Background" Value="{DynamicResource AccentRed}"/>
        </Style>

        <!-- ═══ Ghost Button ═══ -->
        <Style x:Key="AppleGhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="9,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardBackgroundAlt}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Side Panel Toggle ═══ -->
        <Style x:Key="SidePanelToggleBtn" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource LabelSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Margin="0,0,6,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardBackgroundAlt}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ CheckBox — Bento Toggle Style ═══ -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="checkBoxBorder" Width="18" Height="18"
                                    Background="{DynamicResource InputBackground}"
                                    BorderBrush="{DynamicResource BorderBrushColor}"
                                    BorderThickness="1.5" CornerRadius="5"
                                    VerticalAlignment="Center" Margin="0,0,7,0">
                                <Path x:Name="checkMark" Data="M3.5,9.5 L7.5,13.5 L14.5,5"
                                      Stroke="White" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkBoxBorder" Property="Background" Value="{DynamicResource AccentBlue}"/>
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ DataGrid — Bento Table Style ═══ -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrushSubtle}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource CardBackgroundAlt}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource StatusIdleBg}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource StatusInfoBg}"/>
                    <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource LabelSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="12,11"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Segmented Control — Bento / BoardUI Switcher ═══ -->
        <Style x:Key="TabNavButton" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource LabelSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="14,7" Margin="1,0">
                            <ContentPresenter x:Name="cp" VerticalAlignment="Center" HorizontalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cp" Property="TextElement.Foreground" Value="{DynamicResource LabelPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SegmentedSelectedBg}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                <Setter TargetName="cp" Property="TextElement.Foreground" Value="{DynamicResource LabelPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Compact Segmented Button (for Archive filters) ═══ -->
        <Style x:Key="CompactSegmentButton" TargetType="RadioButton" BasedOn="{StaticResource TabNavButton}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="8,6" Margin="1,0">
                            <ContentPresenter x:Name="cp" VerticalAlignment="Center" HorizontalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cp" Property="TextElement.Foreground" Value="{DynamicResource LabelPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SegmentedSelectedBg}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                <Setter TargetName="cp" Property="TextElement.Foreground" Value="{DynamicResource LabelPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Slider — Bento Style ═══ -->
        <Style TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource BorderBrushColor}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBlue}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="16" Height="16" CornerRadius="8" Background="#FFFFFF" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.25"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ ListBoxItem — Bento Grouped List ═══ -->
        <Style x:Key="BentoListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardBackgroundAlt}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource StatusInfoBg}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                <Setter TargetName="bd" Property="TextElement.Foreground" Value="{DynamicResource LabelPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель подключения (Bento Header) -->
            <Border Grid.Row="0" Style="{StaticResource BentoCard}" Padding="16,12" Margin="0,0,0,10">
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Margin="0,0,12,6">
                        <TextBlock Text="Сервер" FontSize="11" Foreground="{DynamicResource LabelSecondary}" Margin="2,0,0,4" FontWeight="Medium"/>
                        <TextBox x:Name="TxtHost" Width="128" Text="localhost"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,6">
                        <TextBlock Text="Порт" FontSize="11" Foreground="{DynamicResource LabelSecondary}" Margin="2,0,0,4" FontWeight="Medium"/>
                        <TextBox x:Name="TxtPort" Width="64" Text="10000"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,6">
                        <TextBlock Text="Логин" FontSize="11" Foreground="{DynamicResource LabelSecondary}" Margin="2,0,0,4" FontWeight="Medium"/>
                        <TextBox x:Name="TxtLogin" Width="100"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,6">
                        <TextBlock Text="Пароль" FontSize="11" Foreground="{DynamicResource LabelSecondary}" Margin="2,0,0,4" FontWeight="Medium"/>
                        <PasswordBox x:Name="TxtPassword" Width="100"/>
                    </StackPanel>
                    <CheckBox x:Name="ChkRemember" Content="Запомнить" IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,14,13"/>

                    <StackPanel Margin="0,0,12,6">
                        <TextBlock Text="Тема" FontSize="11" Foreground="{DynamicResource LabelSecondary}" Margin="2,0,0,4" FontWeight="Medium"/>
                        <ComboBox x:Name="CmbTheme" Width="116" SelectionChanged="CmbTheme_SelectionChanged">
                            <ComboBoxItem Content="☀ Светлая"/>
                            <ComboBoxItem Content="🌙 Тёмная"/>
                            <ComboBoxItem Content="🕒 Авто"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel x:Name="PanelAutoTheme" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,12,6">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="День с" FontSize="11" Foreground="{DynamicResource LabelSecondary}" Margin="2,0,0,4" FontWeight="Medium"/>
                            <TextBox x:Name="TxtThemeLight" Width="56" Text="08:00"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Ночь с" FontSize="11" Foreground="{DynamicResource LabelSecondary}" Margin="2,0,0,4" FontWeight="Medium"/>
                            <TextBox x:Name="TxtThemeDark" Width="56" Text="20:00"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,6">
                        <TextBlock Text="Источник Тнв (улица)" FontSize="11" Foreground="{DynamicResource LabelSecondary}" Margin="2,0,0,4" FontWeight="Medium"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="CmbTnvSource" Width="196" DisplayMemberPath="DisplayName" SelectionChanged="CmbTnvSource_SelectionChanged"/>
                            <Border Background="{DynamicResource StatusInfoBg}" BorderBrush="{DynamicResource StatusInfoBorder}" BorderThickness="1" CornerRadius="10" Padding="10,0" Margin="6,0,0,0" Height="34">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Тнв " FontSize="11.5" Foreground="{DynamicResource LabelSecondary}"/>
                                    <TextBlock x:Name="TxtGlobalTnv" Text="—" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentTeal}"/>
                                    <TextBlock Text=" °C" FontSize="11.5" Foreground="{DynamicResource LabelSecondary}"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="BtnTnvCorrection" Content="±" Style="{StaticResource BentoSecondaryButton}" Padding="10,6" Margin="6,0,0,0" ToolTip="Корректировка датчика наружного воздуха" Click="BtnTnvCorrection_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="BtnConnect" Content="Подключиться" Style="{StaticResource ApplePrimaryButton}" Click="BtnConnect_Click" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                </WrapPanel>
            </Border>

            <!-- Segmented Control — навигация -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource SegmentedBg}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="11" Padding="3" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabAll" Content="Общий мониторинг" Style="{StaticResource TabNavButton}" IsChecked="True" Checked="TabMode_Checked"/>
                        <RadioButton x:Name="TabSingle" Content="Текущие" Style="{StaticResource TabNavButton}" Checked="TabMode_Checked"/>
                        <RadioButton x:Name="TabDashboard" Content="Дашборд" Style="{StaticResource TabNavButton}" Checked="TabMode_Checked"/>
                        <RadioButton x:Name="TabPodpitka" Content="Подпитка" Style="{StaticResource TabNavButton}" Checked="TabMode_Checked"/>
                        <RadioButton x:Name="TabArchive" Content="Архив" Style="{StaticResource TabNavButton}" Checked="TabMode_Checked"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnSettingsGear" Content="⚙ Настройки" Style="{StaticResource BentoSecondaryButton}" Padding="12,7" Click="BtnSettingsGear_Click" ToolTip="Настройки приложения"/>
                </StackPanel>
            </Grid>

            <!-- Экран 1: Общий мониторинг точек -->
            <Grid x:Name="ViewGeneral" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая колонка -->
                <Border x:Name="PanelGeneralLeft" Width="370" Grid.Column="0" Style="{StaticResource BentoCard}" Margin="0,0,6,0" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Объекты и точки учёта" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource LabelPrimary}" Margin="2,0,0,10"/>

                        <StackPanel Grid.Row="1" Margin="0,0,0,10">
                            <TextBox x:Name="TxtSearch" Padding="10,7" Margin="0,0,0,8"
                                     ToolTip="Поиск по названию" TextChanged="ApplyFilters_Changed"/>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CmbNode" Grid.Column="0" Margin="0,0,4,0" SelectionChanged="ApplyFilters_Changed"/>
                                <ComboBox x:Name="CmbSystemType" Grid.Column="1" Margin="4,0,0,0" SelectionChanged="ApplyFilters_Changed"/>
                            </Grid>
                        </StackPanel>

                        <ListBox Grid.Row="2" x:Name="ListPoints" SelectionMode="Multiple"
                                 DisplayMemberPath="DisplayName" BorderThickness="0" Background="Transparent"
                                 ItemContainerStyle="{StaticResource BentoListItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

                        <Border Grid.Row="3" Margin="0,10,0,0" Padding="0,10,0,0" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="0,1,0,0">
                            <Grid>
                                <Button Content="Выделить всё" Style="{StaticResource AppleGhostButton}" HorizontalAlignment="Left" Click="BtnSelectAll_Click"/>
                                <Button Content="Очистить" Style="{StaticResource AppleGhostButton}" Foreground="{DynamicResource AccentRed}" HorizontalAlignment="Right" Click="BtnClearSelection_Click"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Button x:Name="BtnToggleGenPanel" Grid.Column="1" Content="◀" Style="{StaticResource SidePanelToggleBtn}" Click="BtnToggleGeneral_Click" ToolTip="Свернуть/развернуть панель объектов"/>

                <!-- Правая колонка -->
                <Border Grid.Column="2" Style="{StaticResource BentoCard}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0" Margin="0,0,0,10" VerticalAlignment="Center">
                            <TextBlock Text="Текущие параметры" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource LabelPrimary}" VerticalAlignment="Center" Margin="0,0,18,8"/>
                            <Button x:Name="BtnSettings" Content="⚙ Границы" Style="{StaticResource BentoSecondaryButton}" Margin="0,0,8,8" Click="BtnSettingsShared_Click"/>
                            <Button x:Name="BtnStartMonitor" Content="▶ Опросить выбранные" Style="{StaticResource AppleGreenButton}" Margin="0,0,8,8" Click="BtnStartMonitor_Click" IsEnabled="False"/>
                            <Button x:Name="BtnCancelMonitor" Content="✕ Отмена опроса" Style="{StaticResource AppleRedButton}" Margin="0,0,0,8" Visibility="Collapsed" Click="BtnCancelMonitor_Click"/>
                        </WrapPanel>

                        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundAlt}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1" CornerRadius="10" Padding="10,7" Margin="0,0,0,12">
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="Колонки:" FontSize="11.5" Foreground="{DynamicResource LabelSecondary}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <CheckBox Content="T1" IsChecked="True" Click="ColumnToggle_Click"/>
                                <CheckBox Content="T2" IsChecked="True" Click="ColumnToggle_Click"/>
                                <CheckBox Content="P1" IsChecked="True" Click="ColumnToggle_Click"/>
                                <CheckBox Content="P2" IsChecked="False" Click="ColumnToggle_Click"/>
                                <CheckBox Content="V1" IsChecked="True" Click="ColumnToggle_Click"/>
                                <CheckBox Content="V2" IsChecked="False" Click="ColumnToggle_Click"/>
                                <CheckBox Content="M1" IsChecked="True" Click="ColumnToggle_Click"/>
                                <CheckBox Content="M2" IsChecked="True" Click="ColumnToggle_Click"/>
                                <CheckBox Content="Q"  IsChecked="True" Click="ColumnToggle_Click"/>
                                <CheckBox Content="ΔT" IsChecked="True" Click="ColumnToggle_Click"/>
                                <CheckBox Content="ΔP" IsChecked="True" Margin="0" Click="ColumnToggle_Click"/>
                            </WrapPanel>
                        </Border>

                        <Border Grid.Row="2" CornerRadius="12" ClipToBounds="True" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" Background="{DynamicResource CardBackground}">
                            <DataGrid x:Name="GridResults" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Объект учёта" Binding="{Binding NodeTitle}" Width="150"/>
                                    <DataGridTextColumn Header="Точка" Binding="{Binding Title}" Width="120"/>
                                    <DataGridTextColumn Header="Время" Binding="{Binding DeviceTime, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="115"/>
                                    <DataGridTextColumn Header="T1 (°C)" Binding="{Binding T1, StringFormat=\{0:F1\}}" Width="65">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding T1Color}"/><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="T2 (°C)" Binding="{Binding T2, StringFormat=\{0:F1\}}" Width="65">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding T2Color}"/><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="ΔT (°C)" Binding="{Binding DeltaT, StringFormat=\{0:F1\}}" Width="60" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding DeltaTColor}"/></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="P1 (атм)" Binding="{Binding P1, StringFormat=\{0:F1\}}" Width="68">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding P1Color}"/></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="P2 (атм)" Binding="{Binding P2, StringFormat=\{0:F1\}}" Width="68" Visibility="Collapsed">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding P2Color}"/></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="ΔP (атм)" Binding="{Binding DeltaP, StringFormat=\{0:F2\}}" Width="65" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding DeltaPColor}"/></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="V1 (м³/ч)" Binding="{Binding V1, StringFormat=\{0:F2\}}" Width="72">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding V1Color}"/></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="V2 (м³/ч)" Binding="{Binding V2, StringFormat=\{0:F2\}}" Width="72" Visibility="Collapsed">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding V2Color}"/></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="M1 (т)" Binding="{Binding M1, StringFormat=\{0:F2\}}" Width="70">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding M1Color}"/></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="M2 (т)" Binding="{Binding M2, StringFormat=\{0:F2\}}" Width="70">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding M2Color}"/></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Q (Гкал)" Binding="{Binding Q, StringFormat=\{0:F3\}}" Width="72">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding QColor}"/></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Экран 2: Мониторинг текущих -->
            <Grid x:Name="ViewTrend" Grid.Row="2" Visibility="Collapsed">
                <Border Style="{StaticResource BentoCard}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" Margin="0,0,0,14" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,8">
                                <TextBlock Text="Точка учёта:" Foreground="{DynamicResource LabelSecondary}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CmbTrendPoint" Width="380" DisplayMemberPath="DisplayName"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,8">
                                <TextBlock Text="Длительность (мин):" Foreground="{DynamicResource LabelSecondary}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CmbTrendDuration" Width="68"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <Button x:Name="BtnClearTrend" Content="Очистить" Style="{StaticResource BentoSecondaryButton}" Margin="0,0,8,0" Click="BtnClearTrend_Click"/>
                                <Button x:Name="BtnStartTrend" Content="▶ Запустить мониторинг" Style="{StaticResource AppleGreenButton}" Click="BtnStartTrend_Click"/>
                                <Button x:Name="BtnStopTrend" Content="⏹ Остановить" Style="{StaticResource AppleRedButton}" Margin="8,0,0,0" Visibility="Collapsed" Click="BtnStopTrend_Click"/>
                            </StackPanel>
                        </WrapPanel>
                        <Border Grid.Row="1" CornerRadius="12" ClipToBounds="True" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                            <DataGrid x:Name="GridTrend" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Время прибора" Binding="{Binding DeviceTime, StringFormat=\{0:dd.MM.yyyy HH:mm:ss\}}" Width="150"/>
                                    <DataGridTextColumn Header="T1 (°C)" Binding="{Binding T1, StringFormat=\{0:F1\}}" Width="80">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding T1Color}"/><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="T2 (°C)" Binding="{Binding T2, StringFormat=\{0:F1\}}" Width="80">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding T2Color}"/><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="ΔT (°C)" Binding="{Binding DeltaT, StringFormat=\{0:F1\}}" Width="70" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding DeltaTColor}"/></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="P1 (атм)" Binding="{Binding P1, StringFormat=\{0:F1\}}" Width="80">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding P1Color}"/></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="P2 (атм)" Binding="{Binding P2, StringFormat=\{0:F1\}}" Width="80">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding P2Color}"/></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="ΔP (атм)" Binding="{Binding DeltaP, StringFormat=\{0:F2\}}" Width="70" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding DeltaPColor}"/></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="V1 (м³/ч)" Binding="{Binding V1, StringFormat=\{0:F2\}}" Width="80">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding V1Color}"/></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="V2 (м³/ч)" Binding="{Binding V2, StringFormat=\{0:F2\}}" Width="80">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding V2Color}"/></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="M1 (т)" Binding="{Binding M1, StringFormat=\{0:F2\}}" Width="80">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding M1Color}"/></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="M2 (т)" Binding="{Binding M2, StringFormat=\{0:F2\}}" Width="80">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding M2Color}"/></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Q (Гкал)" Binding="{Binding Q, StringFormat=\{0:F3\}}" Width="90">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding QColor}"/></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Экран 3: Дашборд (Bento Grid) -->
            <Grid x:Name="ViewDashboard" Grid.Row="2" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="PanelDashboardLeft" Width="320" Grid.Column="0" Style="{StaticResource BentoCard}" Margin="0,0,6,0" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Точки для Дашборда" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource LabelPrimary}" Margin="2,0,0,10"/>
                        <StackPanel Grid.Row="1" Margin="0,0,0,10">
                            <TextBox x:Name="TxtSearchDashboard" Padding="10,7" Margin="0,0,0,8" ToolTip="Поиск по названию" TextChanged="ApplyFiltersDashboard_Changed"/>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CmbNodeDashboard" Grid.Column="0" Margin="0,0,4,0" SelectionChanged="ApplyFiltersDashboard_Changed"/>
                                <ComboBox x:Name="CmbSystemTypeDashboard" Grid.Column="1" Margin="4,0,0,0" SelectionChanged="ApplyFiltersDashboard_Changed"/>
                            </Grid>
                        </StackPanel>
                        <ListBox Grid.Row="2" x:Name="ListPointsDashboard" SelectionMode="Multiple" DisplayMemberPath="DisplayName"
                                 BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource BentoListItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        <Border Grid.Row="3" Margin="0,10,0,0" Padding="0,10,0,0" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="0,1,0,0">
                            <Grid>
                                <Button Content="Выделить всё" Style="{StaticResource AppleGhostButton}" HorizontalAlignment="Left" Click="BtnSelectAllDashboard_Click"/>
                                <Button Content="Очистить" Style="{StaticResource AppleGhostButton}" Foreground="{DynamicResource AccentRed}" HorizontalAlignment="Right" Click="BtnClearSelectionDashboard_Click"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Button x:Name="BtnToggleDashPanel" Grid.Column="1" Content="◀" Style="{StaticResource SidePanelToggleBtn}" Click="BtnToggleDashboard_Click" ToolTip="Свернуть/развернуть список точек"/>

                <!-- Правая колонка: Плитки Дашборда -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Панель управления дашбордом -->
                    <Border Grid.Row="0" Style="{StaticResource BentoCard}" Padding="14,10" Margin="0,0,0,12">
                        <WrapPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,6">
                                <TextBlock Text="Интервал (мин):" FontSize="12" Foreground="{DynamicResource LabelSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CmbDashboardInterval" Width="64" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border Background="{DynamicResource CardBackgroundAlt}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1" CornerRadius="9" Padding="10,5" Margin="0,0,16,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="ChkDashT" Content="T" IsChecked="True" Click="DashFilter_Click"/>
                                    <CheckBox x:Name="ChkDashP" Content="P" IsChecked="True" Click="DashFilter_Click"/>
                                    <CheckBox x:Name="ChkDashV" Content="V" IsChecked="True" Click="DashFilter_Click"/>
                                    <CheckBox x:Name="ChkDashM" Content="M" IsChecked="True" Click="DashFilter_Click"/>
                                    <CheckBox x:Name="ChkDashQ" Content="Q" IsChecked="True" Click="DashFilter_Click"/>
                                    <CheckBox x:Name="ChkDashDeltaT" Content="ΔT" IsChecked="True" Click="DashFilter_Click"/>
                                    <CheckBox x:Name="ChkDashDeltaP" Content="ΔP" IsChecked="True" Margin="0" Click="DashFilter_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Масштаб ТОЛЬКО ПЛИТОК -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,6">
                                <TextBlock Text="Масштаб плиток:" FontSize="12" Foreground="{DynamicResource LabelSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Slider x:Name="SldUiScale" Width="88" Minimum="0.6" Maximum="1.6" Value="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                <Button x:Name="BtnSettingsDashboard" Content="⚙ Границы" Style="{StaticResource BentoSecondaryButton}" Margin="0,0,8,0" Click="BtnSettingsShared_Click"/>
                                <Button x:Name="BtnForcePoll" Content="⟳ Опросить сейчас" Style="{StaticResource BentoSecondaryButton}" Margin="0,0,8,0" Click="BtnForcePoll_Click" IsEnabled="False"/>
                                <Button x:Name="BtnStartDashboard" Content="▶ Запустить" Style="{StaticResource AppleGreenButton}" Margin="0,0,8,0" Click="BtnStartDashboard_Click" IsEnabled="False"/>
                                <Button x:Name="BtnStopDashboard" Content="⏹ Стоп" Style="{StaticResource AppleRedButton}" Margin="0,0,0,0" Visibility="Collapsed" Click="BtnStopDashboard_Click"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <!-- Одиночный режим (Bento KPI-плитки) -->
                    <Grid x:Name="PanelSinglePoint" Grid.Row="1" Visibility="Collapsed" DataContext="{Binding}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource BentoCard}" Padding="16,12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NodeTitle}" FontSize="20" FontWeight="Bold" Foreground="{Binding TileForeground}"/>
                                        <TextBlock Text="  ·  " FontSize="18" Foreground="{DynamicResource LabelTertiary}"/>
                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource LabelSecondary}" VerticalAlignment="Center"/>
                                        <Button Tag="{Binding}" Click="BtnPollDetails_Click" Margin="10,0,0,0" Width="24" Height="24"
                                                Background="{DynamicResource StatusInfoBg}" BorderBrush="{DynamicResource StatusInfoBorder}" BorderThickness="1" Cursor="Hand" ToolTip="Открыть логи и ход опроса">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                                                        <TextBlock Text="ℹ" Foreground="{DynamicResource AccentTeal}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Border Background="{Binding StatusBadgeBg}" BorderBrush="{Binding StatusBadgeBorder}" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="{Binding SingleStatusColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding SingleStatusColor}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding DeviceTime, StringFormat='Обновлено: {0:dd.MM.yyyy HH:mm:ss}'}" FontSize="12" Foreground="{DynamicResource LabelSecondary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <local:CompactColumnsPanel Spacing="10" MinColumnWidth="200">
                                <local:CompactColumnsPanel.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding ElementName=SldUiScale, Path=Value}"
                                                    ScaleY="{Binding ElementName=SldUiScale, Path=Value}"/>
                                </local:CompactColumnsPanel.LayoutTransform>

                                <!-- Тнв Bento Card -->
                                <Border Height="124" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource StatusInfoBorder}" BorderThickness="1" CornerRadius="16" Padding="16"
                                        ToolTip="Температура наружного воздуха из точки, выбранной в «Источник Тнв (улица)»">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <TextBlock Text="Тнв (улица)" Foreground="{DynamicResource LabelSecondary}" FontSize="12.5" FontWeight="SemiBold"/>
                                            <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentTeal}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ElementName=CmbTnvSource, Path=SelectedItem.DisplayName, TargetNullValue='не выбран', FallbackValue='не выбран'}"
                                                       FontSize="10.5" Foreground="{DynamicResource LabelTertiary}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="TxtTnvCardUpdated" Text="Ожидание..." FontSize="10" Foreground="{DynamicResource LabelTertiary}" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding ElementName=TxtGlobalTnv, Path=Text}" Foreground="{DynamicResource AccentTeal}" FontSize="34" FontWeight="Bold"/>
                                            <TextBlock Text=" °C" Foreground="{DynamicResource LabelSecondary}" FontSize="14" VerticalAlignment="Bottom" Margin="2,0,0,6"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- T1 -->
                                <Border Height="124" Background="{Binding T1DashBg}" BorderBrush="{Binding T1DashBorder}" BorderThickness="1"
                                        Visibility="{Binding Source={x:Static local:DashSettings.Instance}, Path=ShowT, Converter={StaticResource BoolToVis}}" CornerRadius="16" Padding="16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <TextBlock Text="T1 · Подача" Foreground="{DynamicResource LabelSecondary}" FontSize="12.5" FontWeight="SemiBold"/>
                                            <Ellipse Width="7" Height="7" Fill="{Binding T1StatusDot}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Grid.Row="2" VerticalAlignment="Bottom">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding T1, StringFormat=\{0:F1\}, TargetNullValue='—'}" Foreground="{Binding T1DashForeground}" FontSize="34" FontWeight="Bold"/>
                                                <TextBlock Text=" °C" Foreground="{DynamicResource LabelSecondary}" FontSize="14" VerticalAlignment="Bottom" Margin="2,0,0,6"/>
                                            </StackPanel>
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{DynamicResource CardBackgroundAlt}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="8" Padding="7,3"
                                                    Visibility="{Binding ScheduleTargetVisibility}" ToolTip="{Binding ScheduleT1Tooltip}">
                                                <StackPanel>
                                                    <TextBlock Text="график" FontSize="9" Foreground="{DynamicResource LabelTertiary}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ExpectedT1Text}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource LabelSecondary}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- T2 -->
                                <Border Height="124" Background="{Binding T2DashBg}" BorderBrush="{Binding T2DashBorder}" BorderThickness="1"
                                        Visibility="{Binding Source={x:Static local:DashSettings.Instance}, Path=ShowT, Converter={StaticResource BoolToVis}}" CornerRadius="16" Padding="16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <TextBlock Text="T2 · Обратка" Foreground="{DynamicResource LabelSecondary}" FontSize="12.5" FontWeight="SemiBold"/>
                                            <Ellipse Width="7" Height="7" Fill="{Binding T2StatusDot}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Grid.Row="2" VerticalAlignment="Bottom">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding T2, StringFormat=\{0:F1\}, TargetNullValue='—'}" Foreground="{Binding T2DashForeground}" FontSize="34" FontWeight="Bold"/>
                                                <TextBlock Text=" °C" Foreground="{DynamicResource LabelSecondary}" FontSize="14" VerticalAlignment="Bottom" Margin="2,0,0,6"/>
                                            </StackPanel>
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{DynamicResource CardBackgroundAlt}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="8" Padding="7,3"
                                                    Visibility="{Binding ScheduleTargetVisibility}" ToolTip="{Binding ScheduleT2Tooltip}">
                                                <StackPanel>
                                                    <TextBlock Text="график" FontSize="9" Foreground="{DynamicResource LabelTertiary}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ExpectedT2Text}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource LabelSecondary}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- ΔT -->
                                <Border Height="124" Background="{Binding DeltaTDashBg}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                                        Visibility="{Binding Source={x:Static local:DashSettings.Instance}, Path=ShowDeltaT, Converter={StaticResource BoolToVis}}" CornerRadius="16" Padding="16">
                                    <Grid>
                                        <TextBlock Text="ΔT · Перепад" Foreground="{DynamicResource LabelSecondary}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Top"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding DeltaT, StringFormat=\{0:F1\}, TargetNullValue='—'}" Foreground="{DynamicResource LabelPrimary}" FontSize="34" FontWeight="Bold"/>
                                            <TextBlock Text=" °C" Foreground="{DynamicResource LabelSecondary}" FontSize="14" VerticalAlignment="Bottom" Margin="2,0,0,6"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- P1 -->
                                <Border Height="124" Background="{Binding P1DashBg}" BorderBrush="{Binding P1DashBorder}" BorderThickness="1"
                                        Visibility="{Binding Source={x:Static local:DashSettings.Instance}, Path=ShowP, Converter={StaticResource BoolToVis}}" CornerRadius="16" Padding="16">
                                    <Grid>
                                        <TextBlock Text="P1 · Давление" Foreground="{DynamicResource LabelSecondary}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Top"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding P1, StringFormat=\{0:F1\}, TargetNullValue='—'}" Foreground="{Binding P1DashForeground}" FontSize="34" FontWeight="Bold"/>
                                            <TextBlock Text=" атм" Foreground="{DynamicResource LabelSecondary}" FontSize="14" VerticalAlignment="Bottom" Margin="2,0,0,6"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- P2 -->
                                <Border Height="124" Background="{Binding P2DashBg}" BorderBrush="{Binding P2DashBorder}" BorderThickness="1"
                                        Visibility="{Binding Source={x:Static local:DashSettings.Instance}, Path=ShowP, Converter={StaticResource BoolToVis}}" CornerRadius="16" Padding="16">
                                    <Grid>
                                        <TextBlock Text="P2 · Обратка" Foreground="{DynamicResource LabelSecondary}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Top"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding P2, StringFormat=\{0:F1\}, TargetNullValue='—'}" Foreground="{Binding P2DashForeground}" FontSize="34" FontWeight="Bold"/>
                                            <TextBlock Text=" атм" Foreground="{DynamicResource LabelSecondary}" FontSize="14" VerticalAlignment="Bottom" Margin="2,0,0,6"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ΔP -->
                                <Border Height="124" Background="{Binding DeltaPDashBg}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                                        Visibility="{Binding Source={x:Static local:DashSettings.Instance}, Path=ShowDeltaP, Converter={StaticResource BoolToVis}}" CornerRadius="16" Padding="16">
                                    <Grid>
                                        <TextBlock Text="ΔP · Перепад" Foreground="{DynamicResource LabelSecondary}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Top"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding DeltaP, StringFormat=\{0:F2\}, TargetNullValue='—'}" Foreground="{DynamicResource LabelPrimary}" FontSize="34" FontWeight="Bold"/>
                                            <TextBlock Text=" атм" Foreground="{DynamicResource LabelSecondary}" FontSize="14" VerticalAlignment="Bottom" Margin="2,0,0,6"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- V1 -->
                                <Border Height="124" Background="{Binding V1DashBg}" BorderBrush="{Binding V1DashBorder}" BorderThickness="1"
                                        Visibility="{Binding Source={x:Static local:DashSettings.Instance}, Path=ShowV, Converter={StaticResource BoolToVis}}" CornerRadius="16" Padding="16">
                                    <Grid>
                                        <TextBlock Text="V1 · Расход" Foreground="{DynamicResource LabelSecondary}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Top"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding V1, StringFormat=\{0:F2\}, TargetNullValue='—'}" Foreground="{Binding V1DashForeground}" FontSize="32" FontWeight="Bold"/>
                                            <TextBlock Text=" м³/ч" Foreground="{DynamicResource LabelSecondary}" FontSize="13" VerticalAlignment="Bottom" Margin="2,0,0,6"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- V2 -->
                                <Border Height="124" Background="{Binding V2DashBg}" BorderBrush="{Binding V2DashBorder}" BorderThickness="1"
                                        Visibility="{Binding Source={x:Static local:DashSettings.Instance}, Path=ShowV, Converter={StaticResource BoolToVis}}" CornerRadius="16" Padding="16">
                                    <Grid>
                                        <TextBlock Text="V2 · Расход" Foreground="{DynamicResource LabelSecondary}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Top"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding V2, StringFormat=\{0:F2\}, TargetNullValue='—'}" Foreground="{Binding V2DashForeground}" FontSize="32" FontWeight="Bold"/>
                                            <TextBlock Text=" м³/ч" Foreground="{DynamicResource LabelSecondary}" FontSize="13" VerticalAlignment="Bottom" Margin="2,0,0,6"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- M1 -->
                                <Border Height="124" Background="{Binding M1DashBg}" BorderBrush="{Binding M1DashBorder}" BorderThickness="1"
                                        Visibility="{Binding Source={x:Static local:DashSettings.Instance}, Path=ShowM, Converter={StaticResource BoolToVis}}" CornerRadius="16" Padding="16">
                                    <Grid>
                                        <TextBlock Text="M1 · Масса" Foreground="{DynamicResource LabelSecondary}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Top"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding M1, StringFormat=\{0:F2\}, TargetNullValue='—'}" Foreground="{Binding M1DashForeground}" FontSize="32" FontWeight="Bold"/>
                                            <TextBlock Text=" т" Foreground="{DynamicResource LabelSecondary}" FontSize="13" VerticalAlignment="Bottom" Margin="2,0,0,6"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- M2 -->
                                <Border Height="124" Background="{Binding M2DashBg}" BorderBrush="{Binding M2DashBorder}" BorderThickness="1"
                                        Visibility="{Binding Source={x:Static local:DashSettings.Instance}, Path=ShowM, Converter={StaticResource BoolToVis}}" CornerRadius="16" Padding="16">
                                    <Grid>
                                        <TextBlock Text="M2 · Масса" Foreground="{DynamicResource LabelSecondary}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Top"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding M2, StringFormat=\{0:F2\}, TargetNullValue='—'}" Foreground="{Binding M2DashForeground}" FontSize="32" FontWeight="Bold"/>
                                            <TextBlock Text=" т" Foreground="{DynamicResource LabelSecondary}" FontSize="13" VerticalAlignment="Bottom" Margin="2,0,0,6"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Q -->
                                <Border Height="124" Background="{Binding QDashBg}" BorderBrush="{Binding QDashBorder}" BorderThickness="1"
                                        Visibility="{Binding Source={x:Static local:DashSettings.Instance}, Path=ShowQ, Converter={StaticResource BoolToVis}}" CornerRadius="16" Padding="16">
                                    <Grid>
                                        <TextBlock Text="Q · Теплоэнергия" Foreground="{DynamicResource LabelSecondary}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Top"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding Q, StringFormat=\{0:F3\}, TargetNullValue='—'}" Foreground="{Binding QDashForeground}" FontSize="32" FontWeight="Bold"/>
                                            <TextBlock Text=" Гкал" Foreground="{DynamicResource LabelSecondary}" FontSize="13" VerticalAlignment="Bottom" Margin="2,0,0,6"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </local:CompactColumnsPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Множественный режим (Bento Masonry Cards) -->
                    <ScrollViewer x:Name="PanelMultiPoint" Grid.Row="1" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                        <ItemsControl x:Name="ItemsDashboard">
                            <ItemsControl.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding ElementName=SldUiScale, Path=Value}"
                                                ScaleY="{Binding ElementName=SldUiScale, Path=Value}"/>
                            </ItemsControl.LayoutTransform>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <local:MasonryPanel Spacing="10" MaxCardWidth="430" MinCardWidth="250"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                            Background="{Binding TileBackground}" BorderBrush="{Binding TileBorderBrush}" BorderThickness="1.5"
                                            CornerRadius="16" Margin="0" Padding="12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Шапка карточки объекта -->
                                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding NodeTitle}" Foreground="{DynamicResource LabelPrimary}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" ToolTip="{Binding NodeTitle}"/>
                                                    <Border Background="{Binding StatusBadgeBg}" BorderBrush="{Binding TileBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left" Margin="0,4,0,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="6" Height="6" Fill="{Binding StatusAccent}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding GeneralStatus}" Foreground="{Binding StatusAccent}" FontSize="10.5" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <Button Grid.Column="1" Tag="{Binding}" Click="BtnNodeToggle_Click"
                                                        ToolTip="{Binding ToggleTooltip}" Cursor="Hand" VerticalAlignment="Top" Margin="8,0,0,0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Width="24" Height="24" CornerRadius="8" Background="{DynamicResource CardBackgroundAlt}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                                                                <TextBlock Text="{Binding ToggleIcon}" Foreground="{Binding ToggleFg}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>

                                            <!-- Подкарточки точек учёта -->
                                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Points}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <local:CompactColumnsPanel Spacing="6" MinColumnWidth="180"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding PointCardBg}" BorderBrush="{Binding PointCardBorder}" BorderThickness="1" CornerRadius="10" Padding="9,8">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>

                                                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{Binding SingleStatusColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{Binding PointTitleColor}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                    <Button Grid.Column="2" Tag="{Binding}" Click="BtnPollDetails_Click" Width="18" Height="18" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Ход опроса">
                                                                        <TextBlock Text="ℹ" Foreground="{DynamicResource AccentTeal}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Button>
                                                                    <Button Grid.Column="3" Tag="{Binding}" Visibility="{Binding RetryVisibility}" Click="BtnRetryPoint_Click" Width="18" Height="18" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Повторить опрос">
                                                                        <TextBlock Text="↻" Foreground="{DynamicResource AccentOrange}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Button>
                                                                </Grid>

                                                                <Grid Grid.Row="1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>

                                                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,4" Visibility="{Binding Source={x:Static local:DashSettings.Instance}, Path=ShowT, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock Text="T1 / T2" FontSize="9.5" Foreground="{DynamicResource LabelSecondary}"/>
                                                                        <TextBlock FontSize="13" FontWeight="Bold" Foreground="{DynamicResource LabelPrimary}">
                                                                            <Run Text="{Binding T1, StringFormat=\{0:F1\}, TargetNullValue='—', Mode=OneWay}" Foreground="{Binding T1DashForeground}"/><Run Text=" / " Foreground="{Binding SeparatorBrush}"/><Run Text="{Binding T2, StringFormat=\{0:F1\}, TargetNullValue='—', Mode=OneWay}" Foreground="{Binding T2DashForeground}"/>
                                                                        </TextBlock>
                                                                        <TextBlock FontSize="10" Foreground="{DynamicResource LabelSecondary}" Margin="0,1,0,0" Visibility="{Binding Source={x:Static local:DashSettings.Instance}, Path=ShowDeltaT, Converter={StaticResource BoolToVis}}">
                                                                            <Run Text="ΔT "/><Run Text="{Binding DeltaT, StringFormat=\{0:F1\}, TargetNullValue='—', Mode=OneWay}" FontWeight="SemiBold" Foreground="{Binding TileForeground}"/>
                                                                        </TextBlock>
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" Visibility="{Binding Source={x:Static local:DashSettings.Instance}, Path=ShowP, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock Text="P1 / P2" FontSize="9.5" Foreground="{DynamicResource LabelSecondary}"/>
                                                                        <TextBlock FontSize="13" FontWeight="Bold" Foreground="{DynamicResource LabelPrimary}">
                                                                            <Run Text="{Binding P1, StringFormat=\{0:F1\}, TargetNullValue='—', Mode=OneWay}" Foreground="{Binding P1DashForeground}"/><Run Text=" / " Foreground="{Binding SeparatorBrush}"/><Run Text="{Binding P2, StringFormat=\{0:F1\}, TargetNullValue='—', Mode=OneWay}" Foreground="{Binding P2DashForeground}"/>
                                                                        </TextBlock>
                                                                        <TextBlock FontSize="10" Foreground="{DynamicResource LabelSecondary}" Margin="0,1,0,0" Visibility="{Binding Source={x:Static local:DashSettings.Instance}, Path=ShowDeltaP, Converter={StaticResource BoolToVis}}">
                                                                            <Run Text="ΔP "/><Run Text="{Binding DeltaP, StringFormat=\{0:F2\}, TargetNullValue='—', Mode=OneWay}" FontWeight="SemiBold" Foreground="{Binding TileForeground}"/>
                                                                        </TextBlock>
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,2,6,2" Visibility="{Binding Source={x:Static local:DashSettings.Instance}, Path=ShowV, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock Text="V1 / V2" FontSize="9.5" Foreground="{DynamicResource LabelSecondary}"/>
                                                                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource LabelPrimary}">
                                                                            <Run Text="{Binding V1, StringFormat=\{0:F2\}, TargetNullValue='—', Mode=OneWay}" Foreground="{Binding V1DashForeground}"/><Run Text=" / " Foreground="{Binding SeparatorBrush}"/><Run Text="{Binding V2, StringFormat=\{0:F2\}, TargetNullValue='—', Mode=OneWay}" Foreground="{Binding V2DashForeground}"/>
                                                                        </TextBlock>
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,2,0,2" Visibility="{Binding Source={x:Static local:DashSettings.Instance}, Path=ShowM, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock Text="M1 / M2" FontSize="9.5" Foreground="{DynamicResource LabelSecondary}"/>
                                                                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource LabelPrimary}">
                                                                            <Run Text="{Binding M1, StringFormat=\{0:F2\}, TargetNullValue='—', Mode=OneWay}" Foreground="{Binding M1DashForeground}"/><Run Text=" / " Foreground="{Binding SeparatorBrush}"/><Run Text="{Binding M2, StringFormat=\{0:F2\}, TargetNullValue='—', Mode=OneWay}" Foreground="{Binding M2DashForeground}"/>
                                                                        </TextBlock>
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,3,0,0" Visibility="{Binding Source={x:Static local:DashSettings.Instance}, Path=ShowQ, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock FontSize="11" Foreground="{DynamicResource LabelSecondary}">
                                                                            <Run Text="Q: "/><Run Text="{Binding Q, StringFormat=\{0:F3\}, TargetNullValue='—', Mode=OneWay}" FontWeight="Bold" Foreground="{Binding QDashForeground}"/><Run Text=" Гкал"/>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Grid.Row="2" Text="{Binding MaxDeviceTime, StringFormat='Обновлено: {0:dd.MM.yy HH:mm}'}"
                                                       Foreground="{DynamicResource LabelTertiary}" FontSize="10" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Экран 4: Подпитка (Bento Grid) -->
            <Grid x:Name="ViewPodpitka" Grid.Row="2" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="PanelPodpitkaLeft" Width="320" Grid.Column="0" Style="{StaticResource BentoCard}" Margin="0,0,6,0" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Точки подпитки" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource LabelPrimary}" Margin="2,0,0,10"/>
                        <StackPanel Grid.Row="1" Margin="0,0,0,10">
                            <TextBox x:Name="TxtSearchPodpitka" Padding="10,7" Margin="0,0,0,8" ToolTip="Поиск по названию" TextChanged="ApplyFiltersPodpitka_Changed"/>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CmbNodePodpitka" Grid.Column="0" Margin="0,0,4,0" SelectionChanged="ApplyFiltersPodpitka_Changed"/>
                                <ComboBox x:Name="CmbSystemTypePodpitka" Grid.Column="1" Margin="4,0,0,0" SelectionChanged="ApplyFiltersPodpitka_Changed"/>
                            </Grid>
                        </StackPanel>
                        <ListBox Grid.Row="2" x:Name="ListPodpitka" SelectionMode="Multiple" DisplayMemberPath="DisplayName"
                                 BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource BentoListItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ListPodpitka_SelectionChanged"/>
                        <Border Grid.Row="3" Margin="0,10,0,0" Padding="0,10,0,0" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="0,1,0,0">
                            <Grid>
                                <Button Content="Выделить всё" Style="{StaticResource AppleGhostButton}" HorizontalAlignment="Left" Click="BtnSelectAllPodpitka_Click"/>
                                <Button Content="Очистить" Style="{StaticResource AppleGhostButton}" Foreground="{DynamicResource AccentRed}" HorizontalAlignment="Right" Click="BtnClearSelectionPodpitka_Click"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Button x:Name="BtnTogglePodpPanel" Grid.Column="1" Content="◀" Style="{StaticResource SidePanelToggleBtn}" Click="BtnTogglePodpitka_Click" ToolTip="Свернуть/развернуть список точек"/>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource BentoCard}" Padding="14,10" Margin="0,0,0,12">
                        <WrapPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,6">
                                <TextBlock Text="Интервал (мин):" FontSize="12" Foreground="{DynamicResource LabelSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CmbPodpitkaInterval" Width="64" SelectionChanged="CmbPodpitkaInterval_Changed"/>
                            </StackPanel>

                            <!-- Масштаб ТОЛЬКО ПЛИТОК -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,6">
                                <TextBlock Text="Масштаб плиток:" FontSize="12" Foreground="{DynamicResource LabelSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Slider x:Name="SldPodpitkaScale" Width="88" Minimum="0.6" Maximum="1.6" Value="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                <Button x:Name="BtnPodpitkaLimits" Content="⚙ Допуски V1" Style="{StaticResource BentoSecondaryButton}" Margin="0,0,8,0" Click="BtnPodpitkaLimits_Click"/>
                                <Button x:Name="BtnPodpitkaForce" Content="⟳ Опросить сейчас" Style="{StaticResource BentoSecondaryButton}" Margin="0,0,8,0" Click="BtnPodpitkaForce_Click"/>
                                <Button x:Name="BtnStartPodpitka" Content="▶ Запустить" Style="{StaticResource AppleGreenButton}" Margin="0,0,8,0" Click="BtnStartPodpitka_Click"/>
                                <Button x:Name="BtnStopPodpitka" Content="⏹ Стоп" Style="{StaticResource AppleRedButton}" Margin="0,0,0,0" Visibility="Collapsed" Click="BtnStopPodpitka_Click"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ItemsPodpitka">
                            <ItemsControl.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding ElementName=SldPodpitkaScale, Path=Value}"
                                                ScaleY="{Binding ElementName=SldPodpitkaScale, Path=Value}"/>
                            </ItemsControl.LayoutTransform>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <local:MasonryPanel Spacing="10" MaxCardWidth="430" MinCardWidth="250"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding TileBackground}" BorderBrush="{Binding TileBorderBrush}" BorderThickness="1.5" CornerRadius="16" Padding="12" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                                        <StackPanel>
                                            <TextBlock Text="{Binding NodeTitle}" Foreground="{DynamicResource LabelPrimary}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
                                            <Border Background="{Binding StatusBadgeBg}" BorderBrush="{Binding TileBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left" Margin="0,4,0,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Fill="{Binding StatusAccent}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding GeneralStatus}" Foreground="{Binding StatusAccent}" FontSize="10.5" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>

                                            <ItemsControl ItemsSource="{Binding Points}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><local:CompactColumnsPanel Spacing="6" MinColumnWidth="200"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource CardBackgroundAlt}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1" CornerRadius="10" Padding="8">
                                                            <StackPanel>
                                                                <Grid Margin="0,0,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Title}" Foreground="{Binding PointTitleColor}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                                                    <Button Grid.Column="1" Tag="{Binding}" Click="BtnPollDetails_Click" Background="Transparent" BorderThickness="0" Content="ℹ" Foreground="{DynamicResource AccentTeal}" ToolTip="Ход опроса" Cursor="Hand" Margin="4,0"/>
                                                                    <Button Grid.Column="2" Tag="{Binding}" Click="BtnPodpitkaRetry_Click" Visibility="{Binding RetryVisibility}"
                                                                            Background="Transparent" BorderThickness="0" Content="↻" Foreground="{DynamicResource AccentOrange}" ToolTip="Повторить опрос точки" Cursor="Hand"/>
                                                                </Grid>
                                                                <UniformGrid Columns="2">
                                                                    <Border Background="{Binding ReportBg}" BorderBrush="{Binding ReportBorder}" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="2">
                                                                        <StackPanel>
                                                                            <TextBlock Text="Отчётный V1" FontSize="9.5" Foreground="{DynamicResource LabelSecondary}"/>
                                                                            <TextBlock Text="{Binding Report, StringFormat={}{0:F1} м³, TargetNullValue='—'}" FontSize="14" FontWeight="Bold" Foreground="{Binding ReportFg}" Margin="0,2,0,0"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <Border Background="{Binding DayBg}" BorderBrush="{Binding DayBorder}" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="2">
                                                                        <StackPanel>
                                                                            <TextBlock Text="Вчера V1" FontSize="9.5" Foreground="{DynamicResource LabelSecondary}"/>
                                                                            <TextBlock Text="{Binding Day, StringFormat={}{0:F1} м³, TargetNullValue='—'}" FontSize="14" FontWeight="Bold" Foreground="{Binding DayFg}" Margin="0,2,0,0"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <Border Background="{Binding TodayBg}" BorderBrush="{Binding TodayBorder}" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="2">
                                                                        <StackPanel>
                                                                            <TextBlock Text="Сегодня V1" FontSize="9.5" Foreground="{DynamicResource LabelSecondary}"/>
                                                                            <TextBlock Text="{Binding Today, StringFormat={}{0:F1} м³, TargetNullValue='—'}" FontSize="14" FontWeight="Bold" Foreground="{Binding TodayFg}" Margin="0,2,0,0"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <Border Background="{Binding HourBg}" BorderBrush="{Binding HourBorder}" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="2">
                                                                        <StackPanel>
                                                                            <TextBlock Text="Прошлый час" FontSize="9.5" Foreground="{DynamicResource LabelSecondary}"/>
                                                                            <TextBlock Text="{Binding Hour, StringFormat={}{0:F2} м³, TargetNullValue='—'}" FontSize="14" FontWeight="Bold" Foreground="{Binding HourFg}" Margin="0,2,0,0"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </UniformGrid>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Экран 5: Архив показаний (Bento Style) -->
            <Grid x:Name="ViewArchive" Grid.Row="2" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая колонка -->
                <Border x:Name="PanelArchiveLeft" Width="360" Grid.Column="0" Style="{StaticResource BentoCard}" Margin="0,0,6,0" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Точки учёта" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource LabelPrimary}" Margin="2,0,0,10"/>

                        <TextBox Grid.Row="1" x:Name="TxtArchiveSearch" Padding="10,7" Margin="0,0,0,10"
                                 ToolTip="Поиск по названию точки" TextChanged="TxtArchiveSearch_TextChanged"/>

                        <ListBox Grid.Row="2" x:Name="ListArchivePoints" SelectionMode="Single"
                                 DisplayMemberPath="DisplayName" BorderThickness="0" Background="Transparent"
                                 ItemContainerStyle="{StaticResource BentoListItem}"
                                 SelectionChanged="ListArchivePoints_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

                        <!-- Фильтры в стиле BoardUI / Bento -->
                        <Border Grid.Row="3" Margin="0,12,0,0" Padding="0,12,0,0" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <TextBlock Text="Тип архива" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource LabelSecondary}" Margin="2,0,0,6"/>
                                <Border Background="{DynamicResource SegmentedBg}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="10" Padding="3" Margin="0,0,0,12">
                                    <UniformGrid Columns="3">
                                        <RadioButton x:Name="RbArchiveKindHour" Content="Часовые" Style="{StaticResource CompactSegmentButton}" IsChecked="True" Checked="ArchiveKind_Changed"/>
                                        <RadioButton x:Name="RbArchiveKindDay" Content="Суточные" Style="{StaticResource CompactSegmentButton}" Checked="ArchiveKind_Changed"/>
                                        <RadioButton x:Name="RbArchiveKindMonth" Content="Месячные" Style="{StaticResource CompactSegmentButton}" Checked="ArchiveKind_Changed"/>
                                    </UniformGrid>
                                </Border>

                                <TextBlock Text="Период выборки" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource LabelSecondary}" Margin="2,0,0,6"/>
                                <Border Background="{DynamicResource SegmentedBg}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="10" Padding="3" Margin="0,0,0,10">
                                    <UniformGrid Columns="2">
                                        <RadioButton x:Name="RbArchivePreset" Content="Последние дни" Style="{StaticResource CompactSegmentButton}" IsChecked="True" Checked="RbArchiveMode_Changed"/>
                                        <RadioButton x:Name="RbArchiveCustom" Content="Свой период" Style="{StaticResource CompactSegmentButton}" Checked="RbArchiveMode_Changed"/>
                                    </UniformGrid>
                                </Border>

                                <StackPanel x:Name="PanelArchivePreset" Margin="0,0,0,12">
                                    <ComboBox x:Name="CmbArchiveDays" Height="34" SelectedIndex="1" SelectionChanged="ArchiveKind_Changed">
                                        <ComboBoxItem Content="За последние 24 часа"/>
                                        <ComboBoxItem Content="За последние 7 дней"/>
                                        <ComboBoxItem Content="За последние 14 дней"/>
                                        <ComboBoxItem Content="За последние 30 дней"/>
                                        <ComboBoxItem Content="За последние 90 дней"/>
                                        <ComboBoxItem Content="За последний год"/>
                                    </ComboBox>
                                </StackPanel>

                                <Grid x:Name="PanelArchiveCustom" Margin="0,0,0,12" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="С даты" FontSize="10.5" Foreground="{DynamicResource LabelSecondary}" Margin="2,0,0,4"/>
                                        <DatePicker x:Name="DpArchiveFrom" SelectedDateChanged="ArchiveKind_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="По дату" FontSize="10.5" Foreground="{DynamicResource LabelSecondary}" Margin="2,0,0,4"/>
                                        <DatePicker x:Name="DpArchiveTo" SelectedDateChanged="ArchiveKind_Changed"/>
                                    </StackPanel>
                                </Grid>

                                <Button x:Name="BtnArchiveLoad" Content="Загрузить архив" Style="{StaticResource ApplePrimaryButton}"
                                        HorizontalAlignment="Stretch" Click="BtnArchiveLoad_Click"/>
                                <TextBlock x:Name="TxtArchiveStatus" Text="" FontSize="11" Foreground="{DynamicResource LabelSecondary}" TextWrapping="Wrap" Margin="2,8,2,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Button x:Name="BtnToggleArchivePanel" Grid.Column="1" Content="◀" Style="{StaticResource SidePanelToggleBtn}" Click="BtnToggleArchivePanel_Click" ToolTip="Свернуть/развернуть панель точек"/>

                <!-- Правая колонка -->
                <Border Grid.Column="2" Style="{StaticResource BentoCard}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock x:Name="TxtArchiveTitle" Text="Архив показаний" FontWeight="SemiBold" FontSize="15"
                                       Foreground="{DynamicResource LabelPrimary}" VerticalAlignment="Center"/>
                            <Button x:Name="BtnArchiveRefresh" Content="⟳ Обновить" Style="{StaticResource BentoSecondaryButton}" Padding="12,6" HorizontalAlignment="Right" Click="BtnArchiveRefresh_Click"/>
                        </Grid>

                        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundAlt}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,12">
                            <TextBlock x:Name="TxtArchiveInfo" Text="Выберите точку слева и нажмите «Загрузить архив»"
                                       FontSize="12" Foreground="{DynamicResource LabelSecondary}" TextWrapping="Wrap"/>
                        </Border>

                        <Border Grid.Row="2" CornerRadius="12" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" ClipToBounds="True">
                            <DataGrid x:Name="GridArchive" AutoGenerateColumns="False" IsReadOnly="True" ColumnWidth="Auto"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Статус бар -->
            <Border Grid.Row="3" Margin="2,10,2,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource StatusDotOk}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatus" Text="Готово к работе" FontSize="12" Foreground="{DynamicResource LabelSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Модальное окно настройки границ -->
        <Grid x:Name="OverlayLimits" Visibility="Collapsed" Background="#99000000" Panel.ZIndex="100">
            <Border Style="{StaticResource BentoCard}" Effect="{StaticResource PopupShadow}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22" Width="340">
                <StackPanel>
                    <TextBlock x:Name="TxtLimitsTitle" Text="Границы" FontWeight="Bold" FontSize="16" Margin="0,0,0,2" Foreground="{Binding TileForeground}"/>
                    <TextBlock x:Name="TxtLimitsSubtitle" Text="Пустые поля не изменят текущие значения точек" FontSize="11" Foreground="{DynamicResource LabelSecondary}" Margin="0,0,0,12"/>

                    <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="84"/>
                                <ColumnDefinition Width="84"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Column="1" Text="Мин." FontSize="11" HorizontalAlignment="Right" Margin="0,0,10,4" Foreground="{DynamicResource LabelSecondary}"/>
                            <TextBlock Grid.Column="2" Text="Макс." FontSize="11" HorizontalAlignment="Right" Margin="0,0,10,4" Foreground="{DynamicResource LabelSecondary}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="T1 (°C)" FontSize="12" Foreground="{DynamicResource LabelPrimary}" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtT1Min" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" Style="{StaticResource CompactNumericTextBox}"/>
                            <TextBox x:Name="TxtT1Max" Grid.Row="1" Grid.Column="2" Margin="0,0,0,4" Style="{StaticResource CompactNumericTextBox}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="T2 (°C)" FontSize="12" Foreground="{DynamicResource LabelPrimary}" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtT2Min" Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" Style="{StaticResource CompactNumericTextBox}"/>
                            <TextBox x:Name="TxtT2Max" Grid.Row="2" Grid.Column="2" Margin="0,0,0,4" Style="{StaticResource CompactNumericTextBox}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="P1 (атм)" FontSize="12" Foreground="{DynamicResource LabelPrimary}" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtP1Min" Grid.Row="3" Grid.Column="1" Margin="0,0,0,4" Style="{StaticResource CompactNumericTextBox}"/>
                            <TextBox x:Name="TxtP1Max" Grid.Row="3" Grid.Column="2" Margin="0,0,0,4" Style="{StaticResource CompactNumericTextBox}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="P2 (атм)" FontSize="12" Foreground="{DynamicResource LabelPrimary}" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtP2Min" Grid.Row="4" Grid.Column="1" Margin="0,0,0,4" Style="{StaticResource CompactNumericTextBox}"/>
                            <TextBox x:Name="TxtP2Max" Grid.Row="4" Grid.Column="2" Margin="0,0,0,4" Style="{StaticResource CompactNumericTextBox}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="V1 (м³/ч)" FontSize="12" Foreground="{DynamicResource LabelPrimary}" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtV1Min" Grid.Row="5" Grid.Column="1" Margin="0,0,0,4" Style="{StaticResource CompactNumericTextBox}"/>
                            <TextBox x:Name="TxtV1Max" Grid.Row="5" Grid.Column="2" Margin="0,0,0,4" Style="{StaticResource CompactNumericTextBox}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="V2 (м³/ч)" FontSize="12" Foreground="{DynamicResource LabelPrimary}" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtV2Min" Grid.Row="6" Grid.Column="1" Margin="0,0,0,4" Style="{StaticResource CompactNumericTextBox}"/>
                            <TextBox x:Name="TxtV2Max" Grid.Row="6" Grid.Column="2" Margin="0,0,0,4" Style="{StaticResource CompactNumericTextBox}"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="M1 (т)" FontSize="12" Foreground="{DynamicResource LabelPrimary}" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtM1Min" Grid.Row="7" Grid.Column="1" Margin="0,0,0,4" Style="{StaticResource CompactNumericTextBox}"/>
                            <TextBox x:Name="TxtM1Max" Grid.Row="7" Grid.Column="2" Margin="0,0,0,4" Style="{StaticResource CompactNumericTextBox}"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="M2 (т)" FontSize="12" Foreground="{DynamicResource LabelPrimary}" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtM2Min" Grid.Row="8" Grid.Column="1" Margin="0,0,0,4" Style="{StaticResource CompactNumericTextBox}"/>
                            <TextBox x:Name="TxtM2Max" Grid.Row="8" Grid.Column="2" Margin="0,0,0,4" Style="{StaticResource CompactNumericTextBox}"/>

                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Q (Гкал)" FontSize="12" Foreground="{DynamicResource LabelPrimary}" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtQMin" Grid.Row="9" Grid.Column="1" Margin="0,0,0,0" Style="{StaticResource CompactNumericTextBox}"/>
                            <TextBox x:Name="TxtQMax" Grid.Row="9" Grid.Column="2" Margin="0,0,0,0" Style="{StaticResource CompactNumericTextBox}"/>
                        </Grid>
                    </ScrollViewer>

                    <Border Background="{DynamicResource CardBackgroundAlt}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,12">
                        <StackPanel>
                            <Button Content="📈 Температурный график" Click="BtnEditTempSchedule_Click" HorizontalAlignment="Left" FontSize="11.5" Style="{StaticResource AppleGhostButton}"/>
                            <Button Content="📋 График из другой точки" Click="BtnPickScheduleSourceDirect_Click" HorizontalAlignment="Left" FontSize="11.5" Style="{StaticResource AppleGhostButton}"/>
                            <TextBlock Text="Создайте график один раз и применяйте его к любым точкам." FontSize="10.5" TextWrapping="Wrap" Margin="6,2,0,0" Foreground="{DynamicResource LabelSecondary}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Отмена" Click="BtnCancelLimits_Click" Margin="0,0,8,0" Style="{StaticResource BentoSecondaryButton}"/>
                        <Button Content="Применить" Click="BtnSaveLimits_Click" Style="{StaticResource ApplePrimaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Модальное окно настройки температурного графика -->
        <Grid x:Name="OverlayTempSchedule" Visibility="Collapsed" Background="#99000000" Panel.ZIndex="110">
            <Border Style="{StaticResource BentoCard}" Effect="{StaticResource PopupShadow}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Width="640">
                <StackPanel>
                    <TextBlock Text="Температурный график (Тнв → Т1/Т2)" FontWeight="Bold" FontSize="17" Margin="0,0,0,4" Foreground="{Binding TileForeground}"/>

                    <Border Background="{DynamicResource CardBackgroundAlt}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,8,0,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Допустимое отклонение от графика (±)" FontSize="13" Foreground="{DynamicResource LabelPrimary}" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtScheduleTolerance" Grid.Column="1" Text="3" Margin="6,0,6,0" Width="56"
                                         Style="{StaticResource CompactNumericTextBox}" TextChanged="TxtScheduleTolerance_TextChanged"/>
                                <TextBlock Grid.Column="2" Text="°C" FontSize="13" Foreground="{DynamicResource LabelSecondary}" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="TxtScheduleToleranceHint" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource LabelSecondary}" Text="Отклонение применяется к T1 и T2 для всех выбранных точек."/>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="10" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" Margin="0,0,0,12" Height="240" ClipToBounds="True">
                        <DataGrid x:Name="GridTempSchedule" AutoGenerateColumns="False" CanUserAddRows="False" RowEditEnding="GridTempSchedule_RowEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Тнв, °C" Binding="{Binding Tnv, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTextColumn Header="T1, °C" Binding="{Binding T1, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTextColumn Header="T2, °C" Binding="{Binding T2, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTextColumn Header="Допуск T1" Binding="{Binding T1Band, Mode=OneWay}" Width="110" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Допуск T2" Binding="{Binding T2Band, Mode=OneWay}" Width="110" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="📋 Скопировать из другой точки" Click="BtnPickScheduleSource_Click" Margin="0,0,8,0" Style="{StaticResource BentoSecondaryButton}"/>
                        <Button Content="🌐 Применить ко всем точкам" Click="BtnApplyScheduleToAll_Click" Style="{StaticResource BentoSecondaryButton}"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtScheduleSource" Text="" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource AccentBlue}"/>

                    <Grid Margin="0,0,0,14">
                        <Button Content="+ Добавить строку" Click="BtnAddSchedulePoint_Click" HorizontalAlignment="Left" Style="{StaticResource AppleGhostButton}"/>
                        <Button Content="Удалить выбранную" Click="BtnRemoveSchedulePoint_Click" HorizontalAlignment="Right" Foreground="{DynamicResource AccentRed}" Style="{StaticResource AppleGhostButton}"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Отмена" Click="BtnCancelSchedule_Click" Margin="0,0,8,0" Style="{StaticResource BentoSecondaryButton}"/>
                        <Button Content="Сохранить график" Click="BtnSaveSchedule_Click" Style="{StaticResource ApplePrimaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Выбор готового температурного графика -->
        <Grid x:Name="OverlayScheduleSource" Visibility="Collapsed" Background="#99000000" Panel.ZIndex="120">
            <Border Style="{StaticResource BentoCard}" Effect="{StaticResource PopupShadow}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Width="520">
                <StackPanel>
                    <TextBlock Text="Выбрать температурный график из другой точки" FontWeight="Bold" FontSize="16" Margin="0,0,0,4" Foreground="{Binding TileForeground}"/>
                    <TextBlock x:Name="TxtScheduleSourceHint" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource LabelSecondary}"
                               Text="Список точек, у которых уже сохранён график."/>

                    <Border CornerRadius="10" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" Margin="0,0,0,14" Height="260" ClipToBounds="True" Background="{DynamicResource CardBackgroundAlt}">
                        <ListBox x:Name="ListScheduleSources" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource BentoListItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,4">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource LabelPrimary}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource LabelSecondary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Отмена" Click="BtnCancelScheduleSource_Click" Margin="0,0,8,0" Style="{StaticResource BentoSecondaryButton}"/>
                        <Button Content="Выбрать" Click="BtnApplyScheduleSource_Click" Style="{StaticResource ApplePrimaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Модальное окно допусков подпитки -->
        <Grid x:Name="OverlayPodpitkaLimits" Visibility="Collapsed" Background="#99000000" Panel.ZIndex="130">
            <Border Style="{StaticResource BentoCard}" Effect="{StaticResource PopupShadow}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22" Width="340">
                <StackPanel>
                    <TextBlock x:Name="TxtPodpitkaLimitsTitle" Text="Допуски подпитки (V1)" FontWeight="Bold" FontSize="16" Margin="0,0,0,2" Foreground="{Binding TileForeground}"/>
                    <TextBlock x:Name="TxtPodpitkaLimitsSubtitle" Text="Пустые поля не изменят текущие значения точек" FontSize="11" Foreground="{DynamicResource LabelSecondary}" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,14" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="84"/>
                            <ColumnDefinition Width="84"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Column="1" Text="Мин." FontSize="11" HorizontalAlignment="Right" Margin="0,0,10,4" Foreground="{DynamicResource LabelSecondary}"/>
                        <TextBlock Grid.Column="2" Text="Макс." FontSize="11" HorizontalAlignment="Right" Margin="0,0,10,4" Foreground="{DynamicResource LabelSecondary}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Отчётный период" FontSize="12" Foreground="{DynamicResource LabelPrimary}" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtPodpReportMin" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" Style="{StaticResource CompactNumericTextBox}"/>
                        <TextBox x:Name="TxtPodpReportMax" Grid.Row="1" Grid.Column="2" Margin="0,0,0,4" Style="{StaticResource CompactNumericTextBox}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Вчера" FontSize="12" Foreground="{DynamicResource LabelPrimary}" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtPodpDayMin" Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" Style="{StaticResource CompactNumericTextBox}"/>
                        <TextBox x:Name="TxtPodpDayMax" Grid.Row="2" Grid.Column="2" Margin="0,0,0,4" Style="{StaticResource CompactNumericTextBox}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Сегодня" FontSize="12" Foreground="{DynamicResource LabelPrimary}" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtPodpTodayMin" Grid.Row="3" Grid.Column="1" Margin="0,0,0,4" Style="{StaticResource CompactNumericTextBox}"/>
                        <TextBox x:Name="TxtPodpTodayMax" Grid.Row="3" Grid.Column="2" Margin="0,0,0,4" Style="{StaticResource CompactNumericTextBox}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Прошлый час" FontSize="12" Foreground="{DynamicResource LabelPrimary}" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtPodpHourMin" Grid.Row="4" Grid.Column="1" Margin="0,0,0,0" Style="{StaticResource CompactNumericTextBox}"/>
                        <TextBox x:Name="TxtPodpHourMax" Grid.Row="4" Grid.Column="2" Margin="0,0,0,0" Style="{StaticResource CompactNumericTextBox}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Отмена" Click="BtnCancelPodpitkaLimits_Click" Margin="0,0,8,0" Style="{StaticResource BentoSecondaryButton}"/>
                        <Button Content="Применить" Click="BtnSavePodpitkaLimits_Click" Style="{StaticResource ApplePrimaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Модальное окно корректировки Тнв -->
        <Grid x:Name="OverlayTnvCorrection" Visibility="Collapsed" Background="#99000000" Panel.ZIndex="140">
            <Border Style="{StaticResource BentoCard}" Effect="{StaticResource PopupShadow}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Width="420">
                <StackPanel>
                    <TextBlock Text="Корректировка датчика Тнв" FontWeight="Bold" FontSize="17" Margin="0,0,0,4" Foreground="{Binding TileForeground}"/>
                    <TextBlock Text="Поправка (±°C) прибавляется к показаниям датчика и используется для температурного графика."
                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14" Foreground="{DynamicResource LabelSecondary}"/>
                    <Border Background="{DynamicResource CardBackgroundAlt}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Текущий Тнв с датчика:" FontSize="11" Foreground="{DynamicResource LabelSecondary}"/>
                            <TextBlock x:Name="TxtTnvRawValue" Text="—" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource LabelPrimary}" Margin="0,2,0,8"/>
                            <TextBlock Text="Поправка (°C):" FontSize="11" Foreground="{DynamicResource LabelSecondary}" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtTnvCorrectionValue" Grid.Column="0" Style="{StaticResource CompactNumericTextBox}" HorizontalAlignment="Stretch" Width="Auto"/>
                                <Button Grid.Column="1" Content="-0.5" Style="{StaticResource BentoSecondaryButton}" Padding="10,5" Margin="6,0,0,0" Click="BtnTnvCorrectionStep_Click" Tag="-0.5"/>
                                <Button Grid.Column="2" Content="+0.5" Style="{StaticResource BentoSecondaryButton}" Padding="10,5" Margin="4,0,0,0" Click="BtnTnvCorrectionStep_Click" Tag="0.5"/>
                                <Button Grid.Column="3" Content="Сброс" Style="{StaticResource AppleGhostButton}" Margin="4,0,0,0" Click="BtnTnvCorrectionReset_Click"/>
                            </Grid>
                            <TextBlock x:Name="TxtTnvCorrectedPreview" Text="" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentTeal}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Отмена" Click="BtnCancelTnvCorrection_Click" Margin="0,0,8,0" Style="{StaticResource BentoSecondaryButton}"/>
                        <Button Content="Применить" Click="BtnApplyTnvCorrection_Click" Style="{StaticResource ApplePrimaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Модальное окно настроек -->
        <Grid x:Name="OverlayAppSettings" Visibility="Collapsed" Background="#99000000" Panel.ZIndex="150">
            <Border Style="{StaticResource BentoCard}" Effect="{StaticResource PopupShadow}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Width="460">
                <StackPanel>
                    <TextBlock Text="⚙ Настройки" FontWeight="Bold" FontSize="17" Margin="0,0,0,14" Foreground="{Binding TileForeground}"/>

                    <TextBlock Text="Видимость разделов" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource LabelPrimary}" Margin="0,0,0,6"/>
                    <Border Background="{DynamicResource CardBackgroundAlt}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                        <StackPanel>
                            <CheckBox x:Name="ChkSectionGeneral" Content="Общий мониторинг" IsChecked="True" Margin="0,0,0,6" Click="SectionToggle_Click"/>
                            <CheckBox x:Name="ChkSectionTrend" Content="Текущие (тренд)" IsChecked="True" Margin="0,0,0,6" Click="SectionToggle_Click"/>
                            <CheckBox x:Name="ChkSectionDashboard" Content="Дашборд" IsChecked="True" Margin="0,0,0,6" Click="SectionToggle_Click"/>
                            <CheckBox x:Name="ChkSectionPodpitka" Content="Подпитка" IsChecked="True" Margin="0" Click="SectionToggle_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource CardBackgroundAlt}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Экспериментальные функции" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource LabelPrimary}" Margin="0,0,0,4"/>
                            <TextBlock Text="Дополнительные режимы для тестирования." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource LabelSecondary}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ChkExperimentalArchive" Content="Архив показаний" IsChecked="False" Margin="0,0,0,6" Click="ExperimentalToggle_Click"/>
                            <CheckBox x:Name="ChkExperimentalReportPeriod" Content="Настраиваемый отчётный период" IsChecked="False" Margin="0" Click="ExperimentalToggle_Click"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="PanelReportPeriodSettings" Background="{DynamicResource CardBackgroundAlt}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Отчётный период подпитки" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource LabelPrimary}" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="С (день):" FontSize="12" Foreground="{DynamicResource LabelSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CmbReportPeriodStartDay" Grid.Column="1" SelectionChanged="CmbReportPeriodStartDay_Changed"/>
                                <TextBlock Grid.Column="2" Text="По (день):" FontSize="12" Foreground="{DynamicResource LabelSecondary}" VerticalAlignment="Center" Margin="8,0,8,0"/>
                                <ComboBox x:Name="CmbReportPeriodEndDay" Grid.Column="3" SelectionChanged="CmbReportPeriodEndDay_Changed"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Перенос настроек" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource LabelPrimary}" Margin="0,0,0,6"/>
                    <Border Background="{DynamicResource CardBackgroundAlt}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Сохраняет графики, границы, выбранные точки и тему в JSON без логина и пароля." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource LabelSecondary}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Экспортировать" Style="{StaticResource ApplePrimaryButton}" Margin="0,0,8,0" Click="BtnExportSettings_Click"/>
                                <Button Content="Импортировать" Style="{StaticResource BentoSecondaryButton}" Click="BtnImportSettings_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Закрыть" Click="BtnCloseAppSettings_Click" Style="{StaticResource ApplePrimaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
